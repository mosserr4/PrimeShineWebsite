<form class="contact-form" action="https://formspree.io/f/REPLACE_WITH_YOUR_ID" method="POST">
  <label>
    Name
    <input type="text" name="name" required>
  </label>
  <label>
    Email
    <input type="email" name="_replyto" required>
  </label>
  <label>
    Phone
    <input type="tel" name="phone">
  </label>
  <label>
    Message
    <textarea name="message" rows="5"></textarea>
  </label>

  <!-- If you'd like submissions sent to ian.moser7@icloud.com via Formspree:
       1) Create a form at Formspree and get the form ID.
       2) Replace the action URL above with https://formspree.io/f/YOUR_ID
       Formspree will forward submissions to the email you register with their service. -->
  <button type="submit">Send</button>
</form>
